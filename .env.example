# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/abdirahman-asad-store
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/abdirahman-asad-store
MONGODB_URI=

# ---------------------------------------------------------------------------
# Clerk (https://dashboard.clerk.com -> API keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's hosted components live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ---------------------------------------------------------------------------
# Admin bootstrap
# ---------------------------------------------------------------------------
# Comma-separated emails that are always treated as administrators. Use this to
# promote yourself the first time. For everyone else, set
# publicMetadata.role = "admin" on the user in the Clerk dashboard.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Cloudinary (https://console.cloudinary.com -> Dashboard)
# ---------------------------------------------------------------------------
# The cloud name is public (used by the browser to POST the file directly).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
